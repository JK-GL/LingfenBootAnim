<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="菱粉开机动画"
            android:textColor="@color/t1"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="视频 → bootanimation.zip"
            android:textColor="@color/t3"
            android:textSize="13sp" />

        <!-- 选视频卡片 -->
        <LinearLayout
            android:id="@+id/cardPick"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dashed"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvPlus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="＋"
                android:textColor="@color/accent"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tvPickLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="选择视频"
                android:textColor="@color/t2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/t3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 画布 -->
        <TextView
            style="@style/SectionTitle"
            android:text="画布尺寸" />

        <RadioGroup
            android:id="@+id/rgCanvas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb1080"
                style="@style/OptionRow"
                android:checked="true"
                android:text="1920 × 1080   横屏（车机）" />

            <RadioButton
                android:id="@+id/rb720"
                style="@style/OptionRow"
                android:text="1280 × 720   横屏（720p 车机）" />

            <RadioButton
                android:id="@+id/rbPortrait"
                style="@style/OptionRow"
                android:text="1080 × 1920   竖屏" />
        </RadioGroup>

        <!-- 帧率 -->
        <TextView
            style="@style/SectionTitle"
            android:text="帧率（决定播放速度）" />

        <RadioGroup
            android:id="@+id/rgFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb25"
                style="@style/OptionChip"
                android:checked="true"
                android:text="25" />

            <RadioButton
                android:id="@+id/rb30"
                style="@style/OptionChip"
                android:text="30" />

            <RadioButton
                android:id="@+id/rb15"
                style="@style/OptionChip"
                android:text="15" />
        </RadioGroup>

        <!-- 时长 -->
        <TextView
            style="@style/SectionTitle"
            android:text="时长" />

        <RadioGroup
            android:id="@+id/rgDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFull"
                style="@style/OptionChip"
                android:checked="true"
                android:text="全片" />

            <RadioButton
                android:id="@+id/rb15s"
                style="@style/OptionChip"
                android:text="限 15 秒" />

            <RadioButton
                android:id="@+id/rb10s"
                style="@style/OptionChip"
                android:text="限 10 秒" />
        </RadioGroup>

        <!-- 预估 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_solid"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvEstimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择视频后显示预估信息"
                android:textColor="@color/t2"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- 进度 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/t3"
            android:textSize="12sp" />

        <!-- 生成按钮 -->
        <Button
            android:id="@+id/btnGo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:enabled="false"
            android:text="生成 bootanimation.zip"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="输出目录：下载/LingfenBoot/"
            android:textColor="@color/t3"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
